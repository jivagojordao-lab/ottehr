# ==============================================================================
# OTTEHR BRASIL - CONFIGURAÇÃO DE PRODUÇÃO (R$ 0 / MÊS)
# ==============================================================================

# Domínio onde o sistema será acessado (ex: prontuario.minhaclinica.com.br ou localhost)
# O Caddy emitirá certificado SSL/HTTPS gratuito automaticamente para este domínio!
APP_DOMAIN=localhost

# Seu e-mail para avisos de expiração do certificado SSL (Let's Encrypt)
ACME_EMAIL=admin@minhaclinica.com.br

# Senha do banco de dados PostgreSQL interno
POSTGRES_PASSWORD=altere_para_uma_senha_forte_aqui

# Integração Memed (Prescrição Digital com ICP-Brasil)
# Obtenha sua chave gratuita em https://memed.com.br
MEMED_API_KEY=
MEMED_SECRET_KEY=
