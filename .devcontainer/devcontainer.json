{
  "name": "Ottehr Brasil Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableMoby": true
    }
  },
  "forwardPorts": [8103, 3000, 5173],
  "portsAttributes": {
    "8103": {
      "label": "Medplum FHIR Server",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "Ottehr Express API Gateway",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Ottehr EHR Frontend",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm install -g pnpm && echo 'Codespace ready for Ottehr Brasil!'"
}
